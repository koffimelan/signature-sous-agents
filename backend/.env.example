# --- Serveur ---
PORT=4100
NODE_ENV=development
# Chaîne aléatoire longue, à changer en production (elle sert aussi à hacher les codes OTP)
JWT_SECRET=remplacer_par_une_longue_chaine_aleatoire
JWT_DUREE=8h

# --- Base de données ---
# sqlite : aucune installation nécessaire (fichier data/contrats.sqlite), pratique pour le développement
# postgres : base de production prévue dans le dossier de conception
DB_DIALECT=sqlite
DB_STORAGE=data/contrats.sqlite
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=contrats_sous_agents
# DB_USER=postgres
# DB_PASSWORD=

# --- Fichiers conservés (pièces et contrats) et cachet électronique de la banque ---
STOCKAGE_DIR=stockage
CLES_DIR=cles

# --- Codes de signature (OTP) ---
OTP_DUREE_MINUTES=10
OTP_MAX_TENTATIVES=3
# Démonstration sans serveur de messagerie : le code s'affiche à l'écran (ignoré en production)
OTP_AFFICHER_CODE=oui

# --- Alertes d'échéance (RG6) ---
SEUIL_ALERTE_1=30
SEUIL_ALERTE_2=7
# Tous les jours à 7h (heure d'Abidjan)
CRON_ALERTES=0 7 * * *
ALERTES_DESTINATAIRES=

# --- E-mail (si SMTP_HOST est vide, les e-mails sont affichés dans la console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Contrats des sous-agents <contrats@exemple.ci>"

# --- Données de démonstration (npm run seed) ---
# Mot de passe commun des comptes de test créés par le seed
SEED_PASSWORD=Contrats@2026
